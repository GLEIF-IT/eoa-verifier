{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Initial EOA verifier assessment",
  "description": "Structural result shape only; not a signed envelope or proof of verification/freshness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "profile",
    "associationSaid",
    "revision",
    "outcome",
    "reasonCode"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "profile": {
      "const": "vlei-external-association/eoa/v1"
    },
    "associationSaid": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "outcome": {
      "enum": [
        "valid",
        "invalid",
        "unavailable"
      ]
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuerAid",
        "leSaid",
        "qviSaid",
        "extId"
      ],
      "properties": {
        "issuerAid": {
          "type": "string",
          "minLength": 1
        },
        "leSaid": {
          "type": "string",
          "minLength": 1
        },
        "qviSaid": {
          "type": "string",
          "minLength": 1
        },
        "extId": {
          "type": "string",
          "pattern": "^eip155:[1-9][0-9]{0,31}:0x[0-9a-f]{40}(?![\\s\\S])"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "valid"
          }
        }
      },
      "then": {
        "required": [
          "binding"
        ]
      }
    }
  ]
}
